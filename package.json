{
  "name": "workflow-repository-template",
  "version": "0.1.0",
  "description": "An example workflow repository template.",
  "main": "dist/temporal/workers/worker.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/temporal/workers/worker.js",
    "start:worker": "node dist/temporal/workers/worker.js",
    "start:api": "tsx src/api/server.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@ai-generated-workflow/sdk": "file:generated/ai-generated-workflow",
    "@ai-sdk/anthropic": "^1.2.12",
    "@osdk/client": "^2.1.5",
    "@osdk/oauth": "^1.1.2",
    "@sendgrid/mail": "^8.1.5",
    "ai": "^4.3.16",
    "dotenv": "^16.5.0",
    "zod": "^3.25.30"
  },
  "devDependencies": {
    "@temporalio/activity": "^1.11.8",
    "@temporalio/client": "^1.11.8",
    "@temporalio/worker": "^1.11.8",
    "@temporalio/workflow": "^1.11.8",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.0.0",
    "lint-staged": "^15.2.2",
    "ts-jest": "^29.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.0.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
